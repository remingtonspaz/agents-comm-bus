{
  "name": "claude-code-telegram-bridge",
  "version": "2.0.0",
  "description": "Telegram MCP integration for Claude Code",
  "type": "module",
  "main": "hosts/claude/claude-mcp-shim.js",
  "workspaces": [
    "agents-comm-bus",
    "packages/*",
    "hosts",
    "mcp-server"
  ],
  "scripts": {
    "install-telegram": "node install.js",
    "status": "node install.js --status",
    "pretest": "npm --workspace packages/core-contracts run build",
    "test": "node --test --expose-gc --import tsx tests/architecture/*.test.ts",
    "pretest:core": "npm --workspace packages/core-contracts run build",
    "test:core": "node --test --expose-gc --import tsx tests/architecture/sqlite-schema.test.ts tests/architecture/bus-invariants.test.ts tests/architecture/query-resolution.test.ts",
    "pretest:bootstrap": "npm --workspace packages/core-contracts run build",
    "test:bootstrap": "node --test --expose-gc --import tsx tests/architecture/bootstrap-race.test.ts tests/architecture/ipc-versioning.test.ts tests/architecture/account-registration-cli.test.ts",
    "pretest:daemon": "npm --workspace packages/core-contracts run build",
    "test:daemon": "node --test --expose-gc --import tsx tests/architecture/daemon-build-assets.test.ts tests/architecture/restart-survival.test.ts tests/architecture/session-lease.test.ts",
    "pretest:adapter": "npm --workspace packages/core-contracts run build",
    "test:adapter": "node --test --expose-gc --import tsx tests/architecture/allowlist-factory.test.ts tests/architecture/reload-allowlist-refresh.test.ts tests/architecture/drain-pending-inbound.test.ts tests/architecture/telegram-comm-adapter.test.ts",
    "pretest:bridge": "npm --workspace packages/core-contracts run build",
    "test:bridge": "node --test --expose-gc --import tsx tests/architecture/claude-wake.test.ts tests/architecture/codex-agent-adapter.test.ts tests/architecture/codex-turn-control.test.ts tests/architecture/codex-app-server-lifecycle.test.ts",
    "pretest:hooks": "npm --workspace packages/core-contracts run build",
    "test:hooks": "node --test --expose-gc --import tsx tests/architecture/claude-hooks.test.ts tests/architecture/codex-hooks.test.ts tests/architecture/codex-app-server-lifecycle.test.ts",
    "assemble:skills": "node scripts/assemble-skills.js",
    "stage:plugins": "node scripts/stage-plugins.js",
    "stage:plugins:verify": "node scripts/stage-plugins.js --verify",
    "verify:clean-build": "node scripts/verify-clean-build.mjs",
    "check:version-bump": "node scripts/check-version-bump.mjs",
    "check:ipc-protocol": "node scripts/check-ipc-protocol-bump.mjs",
    "bump:daemon": "node scripts/bump-version.mjs daemon",
    "bump:adapter": "node scripts/bump-version.mjs adapter"
  },
  "dependencies": {
    "node-telegram-bot-api": "^0.66.0",
    "ws": "^8.18.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "tsx": "4.22.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "telegram",
    "claude-code",
    "mcp",
    "automation"
  ],
  "author": "Claude Code User",
  "license": "MIT"
}
