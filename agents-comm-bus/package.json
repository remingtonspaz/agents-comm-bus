{
  "name": "agents-comm-bus",
  "version": "0.1.0",
  "description": "Per-user daemon and localhost IPC layer for agent communication adapters.",
  "type": "module",
  "main": "./dist/core-daemon/daemon.js",
  "types": "./dist/core-daemon/daemon.d.ts",
  "bin": {
    "agents-comm": "./dist/core-daemon/cli/index.js",
    "agents-comm-bus": "./dist/core-daemon/cli/index.js",
    "agents-comm-bus-daemon": "./dist/core-daemon/serve.js"
  },
  "exports": {
    ".": {
      "import": "./dist/core-daemon/daemon.js",
      "types": "./dist/core-daemon/daemon.d.ts"
    },
    "./paths": {
      "import": "./dist/core-daemon/paths.js",
      "types": "./dist/core-daemon/paths.d.ts"
    },
    "./config": {
      "import": "./dist/core-daemon/config.js",
      "types": "./dist/core-daemon/config.d.ts"
    },
    "./bootstrap/ensure-daemon": {
      "import": "./dist/core-daemon/bootstrap/ensure-daemon.js",
      "types": "./dist/core-daemon/bootstrap/ensure-daemon.d.ts"
    },
    "./bootstrap/spawn-lock": {
      "import": "./dist/core-daemon/bootstrap/spawn-lock.js",
      "types": "./dist/core-daemon/bootstrap/spawn-lock.d.ts"
    },
    "./bootstrap/handshake": {
      "import": "./dist/core-daemon/bootstrap/handshake.js",
      "types": "./dist/core-daemon/bootstrap/handshake.d.ts"
    },
    "./ipc/protocol": {
      "import": "./dist/core-daemon/ipc/protocol.js",
      "types": "./dist/core-daemon/ipc/protocol.d.ts"
    },
    "./ipc/server": {
      "import": "./dist/core-daemon/ipc/server.js",
      "types": "./dist/core-daemon/ipc/server.d.ts"
    },
    "./ipc/client": {
      "import": "./dist/core-daemon/ipc/client.js",
      "types": "./dist/core-daemon/ipc/client.d.ts"
    },
    "./ipc/persistent-client": {
      "import": "./dist/core-daemon/ipc/persistent-client.js",
      "types": "./dist/core-daemon/ipc/persistent-client.d.ts"
    },
    "./bus": {
      "import": "./dist/core-daemon/bus.js",
      "types": "./dist/core-daemon/bus.d.ts"
    },
    "./project-path": {
      "import": "./dist/core-daemon/project-path.js",
      "types": "./dist/core-daemon/project-path.d.ts"
    },
    "./storage/sqlite": {
      "import": "./dist/core-daemon/storage/sqlite.js",
      "types": "./dist/core-daemon/storage/sqlite.d.ts"
    },
    "./cli": {
      "import": "./dist/core-daemon/cli/index.js",
      "types": "./dist/core-daemon/cli/index.d.ts"
    },
    "./host-entry": {
      "import": "./dist/core-daemon/host-entry.js",
      "types": "./dist/core-daemon/host-entry.d.ts"
    }
  },
  "scripts": {
    "build": "tsc && node scripts/copy-assets.js",
    "build:bundles": "node scripts/build-bundles.mjs",
    "build:all": "npm run build && npm run build:bundles",
    "typecheck": "tsc --noEmit",
    "test": "node --test --expose-gc --import tsx \"../tests/architecture/bootstrap-race.test.ts\" \"../tests/architecture/ipc-versioning.test.ts\" \"../tests/architecture/sqlite-schema.test.ts\" \"../tests/architecture/age56-durable-inbound.test.ts\" \"../tests/architecture/allowlist-factory.test.ts\" \"../tests/architecture/reload-allowlist-refresh.test.ts\" \"../tests/architecture/drain-pending-inbound.test.ts\" \"../tests/architecture/daemon-pid-watchdog.test.ts\" \"../tests/architecture/account-registration-cli.test.ts\" \"../tests/architecture/central-install-reconcile.test.ts\" \"../tests/architecture/central-install-execute.test.ts\" \"../tests/architecture/central-install-concurrency.test.ts\" \"../tests/architecture/central-install-mode.test.ts\" \"../tests/architecture/dev-config-resolver.test.ts\" \"../tests/architecture/install-stamp.test.ts\" \"../tests/architecture/entry-ensures.test.ts\" \"../tests/architecture/entry-ensures-subprocess.test.ts\" \"../tests/architecture/host-entry-export.test.ts\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@discordjs/rest": "^2.6.1",
    "@discordjs/ws": "^2.0.4",
    "discord-api-types": "^0.38.48",
    "node-telegram-bot-api": "^0.66.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/node-telegram-bot-api": "0.64.14",
    "@types/ws": "8.18.1",
    "tsx": "4.22.3",
    "typescript": "5.9.3"
  }
}
