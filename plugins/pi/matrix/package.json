{
  "name": "@agents-comm-bus/pi-matrix",
  "version": "0.1.2",
  "description": "Pi host extension for agents-comm-bus — matrix comm (bundles the shared pi-core).",
  "type": "module",
  "keywords": ["pi-package"],
  "pi": {
    "extensions": [
      "node_modules/@agents-comm-bus/pi-core/extensions",
      "./extensions/matrix"
    ],
    "skills": ["./skills"]
  },
  "dependencies": {
    "@agents-comm-bus/pi-core": "0.1.1"
  },
  "bundledDependencies": ["@agents-comm-bus/pi-core"],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": { "node": ">=22" },
  "scripts": {
    "postinstall": "node ./scripts/postinstall.mjs"
  },
  "license": "MIT"
}
